# Copia este archivo a `.env` en la raiz del proyecto y completa los valores.
# Nunca commitees el `.env` real.

# Token del bot de Discord
BOT_TOKEN=

# IDs de los canales de Discord
CHANNEL_ID_REGLAS=
CHANNEL_ID_PRESENTACION=
CHANNEL_ID_ROLES=
CHANNEL_ID_ADMINS=

# IDs de los roles para auto-asignacion
ROLE_ID_ESTUDIANTE=
ROLE_ID_PROFE=
ROLE_ID_VOLUNTARIE=
ROLE_ID_COMUNIDAD=
ROLE_ID_ADMIN=

# IDs de mensajes persistentes (se guardan automaticamente la primera vez que el bot los crea)
MESSAGE_ID_ROLES_PRONOMBRES=
MESSAGE_ID_ROLES_HABILIDADES=
MESSAGE_ID_REGLAS=
